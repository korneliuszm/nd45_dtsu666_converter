[Unit]
Description=Modbus bridges -> DTSU666 (Sigenergy Power Sensor)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Watches event-loop liveness, not poller progress: a single stalled poll loop is
# rebuilt in-process per bridge (see app.supervise_poller), because a restart here
# would take every configured bridge down at once. Alert on
# nd45_dtsu666_bridge_poller_restarts_total instead.
WatchdogSec=90
# One process serves every bridge in config.json -- with two bridges that is two
# RS-485 ports (/dev/ttyAMA2 and /dev/ttyAMA3). Make sure the service user can open
# both (dialout group) and that the second UART is enabled in the device tree.
WorkingDirectory=/opt/nd45_dtsu666
ExecStart=/opt/nd45_dtsu666/.venv/bin/python -m nd45_dtsu666 \
  --config /opt/nd45_dtsu666/config/config.json \
  --registers /opt/nd45_dtsu666/config/registers.json \
  run
Restart=always
RestartSec=2
# Logs go to journald via stdout/stderr
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
